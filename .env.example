# Copy to .env.local (local only, never commit).
# The browser calls /api/* on this Next.js app, and next.config.ts proxies it to the backend.

# Backend running on your machine (see the backend repo, default port 3000):
SERVER_API_URL=http://localhost:3000

# Used by pages that call the backend directly (and as the proxy fallback).
# Keep it the same as SERVER_API_URL for local work.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
